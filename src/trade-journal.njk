{% set root = "../" %}
{% set toTop = "#main" %}
{% extends "base.njk" %}

{% block head %}
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>Trade Journal — Aslam</title>
  <meta name="description" content="Stop loss and take profit calculator for the retest system: 1:1 risk to reward, 8% stop, 8% target, 40 trading day time exit. Keep your own trade journal on your device, and watch Aslam's journal live.">
  <link rel="canonical" href="https://iamaslam.com/trade-journal/">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Aslam">
  <meta property="og:title" content="Trade Journal — Aslam">
  <meta property="og:description" content="1:1 RR calculator (8% stop, 8% target, 40-day time exit), a device journal for anyone, and Aslam's live journal.">
  <meta property="og:url" content="https://iamaslam.com/trade-journal/">
  <meta name="theme-color" content="#FFFCF7">
  <link rel="icon" type="image/svg+xml" href="../assets/favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Inter+Tight:ital,wght@0,300..800;1,300..800&family=JetBrains+Mono:wght@300..700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="../css/main.css">
  <style>
    .tj-wrap { max-width: 860px; margin: 0 auto; }
    .tj-card { background: #fff; border: 2px solid var(--ink); box-shadow: var(--shadow); padding: 1.1rem 1.1rem 1.25rem; margin-bottom: 1.6rem; }
    .tj-form { display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem; }
    @media (max-width: 560px) { .tj-form { grid-template-columns: 1fr; } }
    .tj-field label { display: block; font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; color: var(--ink-70); margin-bottom: 0.35rem; }
    .tj-field input, .tj-field select { width: 100%; box-sizing: border-box; font-family: var(--font-mono); font-size: 1.15rem; font-weight: 700; padding: 0.6rem 0.7rem; border: 2px solid var(--ink); background: var(--paper); color: var(--ink); border-radius: 0; }
    .tj-field input:focus, .tj-field select:focus { outline: 3px solid var(--lime); outline-offset: 1px; }
    .tj-outs { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.9rem; margin-top: 1.1rem; }
    @media (max-width: 560px) { .tj-outs { grid-template-columns: 1fr; } }
    .tj-out { border: 2px solid var(--ink); padding: 0.7rem 0.8rem; background: var(--paper); }
    .tj-out .k { font-family: var(--font-mono); font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; }
    .tj-out .v { font-family: var(--font-display); font-weight: 800; font-size: 1.7rem; line-height: 1.05; margin-top: 0.2rem; }
    .tj-out .s { font-family: var(--font-mono); font-size: 0.75rem; color: var(--ink-70); margin-top: 0.25rem; }
    .tj-out.sl { box-shadow: 4px 4px 0 #d64541; } .tj-out.sl .k { color: #d64541; }
    .tj-out.tp { box-shadow: 4px 4px 0 #1a9850; } .tj-out.tp .k { color: #1a9850; }
    .tj-out.tm { box-shadow: 4px 4px 0 #b8860b; } .tj-out.tm .k { color: #b8860b; }
    .tj-add { margin-top: 1.1rem; width: 100%; }
    .tj-note { font-size: 0.85rem; color: var(--ink-70); margin-top: 0.8rem; }
    .tj-stats { display: flex; flex-wrap: wrap; gap: 0.5rem 1.2rem; font-family: var(--font-mono); font-size: 0.85rem; font-weight: 700; margin-bottom: 1rem; }
    .tj-score { background: #fff; border: 2px solid var(--ink); box-shadow: var(--shadow-sm); padding: 0.7rem 0.9rem; margin-bottom: 1rem; font-family: var(--font-mono); font-size: 0.85rem; font-weight: 700; }
    .tj-score:empty { display: none; }
    .tj-score .hd { font-family: var(--font-display); font-size: 1.05rem; margin-bottom: 0.35rem; }
    .tj-score div { margin: 0.18rem 0; }
    .tj-score .dim { color: var(--ink-70); font-weight: 400; }
    .tj-entry { background: #fff; border: 2px solid var(--ink); box-shadow: var(--shadow-sm); padding: 0.8rem 0.9rem; margin-bottom: 0.9rem; }
    .tj-row1 { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.3rem 0.9rem; }
    .tj-tick { font-family: var(--font-display); font-weight: 800; font-size: 1.45rem; letter-spacing: -0.02em; }
    .tj-nums { font-family: var(--font-mono); font-size: 0.9rem; font-weight: 700; }
    .tj-nums .sl { color: #d64541; } .tj-nums .tp { color: #1a9850; }
    .tj-date { font-family: var(--font-mono); font-size: 0.78rem; color: var(--ink-70); }
    .tj-badge { font-family: var(--font-mono); font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; border: 2px solid var(--ink); padding: 0.12rem 0.45rem; }
    .tj-badge.won { background: #1a9850; color: #fff; }
    .tj-badge.lost { background: #d64541; color: #fff; }
    .tj-badge.time { background: #b8860b; color: #fff; }
    .tj-bar { height: 14px; border: 2px solid var(--ink); background: #eee7d8; margin-top: 0.6rem; position: relative; }
    .tj-bar > div { height: 100%; transition: width 0.3s; }
    .tj-bar .g { background: #1a9850; } .tj-bar .y { background: #f2c018; } .tj-bar .r { background: #d64541; }
    .tj-days { font-family: var(--font-mono); font-size: 0.82rem; font-weight: 700; margin-top: 0.4rem; }
    .tj-days .r { color: #d64541; } .tj-days .y { color: #9a7400; } .tj-days .g { color: #1a9850; }
    .tj-actions { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-top: 0.65rem; align-items: center; }
    .tj-btn { font-family: var(--font-mono); font-size: 0.75rem; font-weight: 700; border: 2px solid var(--ink); background: var(--paper); color: var(--ink); padding: 0.32rem 0.6rem; cursor: pointer; }
    .tj-btn:hover { background: var(--ink); color: var(--paper); }
    .tj-btn.danger:hover { background: #d64541; border-color: #d64541; color: #fff; }
    .tj-btn.on { background: var(--ink); color: var(--paper); }
    .tj-typebar { display: flex; flex-wrap: wrap; gap: 0.45rem; align-items: center; margin-bottom: 0.9rem; }
    .tj-typebar .k { font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; color: var(--ink-70); margin-right: 0.2rem; }
    .tj-close { display: none; margin-top: 0.65rem; gap: 0.45rem; align-items: center; flex-wrap: wrap; }
    .tj-close.open { display: flex; }
    .tj-close input { font-family: var(--font-mono); font-size: 0.95rem; font-weight: 700; padding: 0.35rem 0.5rem; border: 2px solid var(--ink); width: 8.5rem; }
    .tj-empty { font-family: var(--font-mono); font-size: 0.9rem; color: var(--ink-70); border: 2px dashed var(--ink-45); padding: 1rem; text-align: center; }
    .tj-del { margin-left: auto; }
    .tj-jhead { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.9rem; margin-bottom: 0.9rem; margin-top: 2rem; }
    .tj-jhead h2 { font-family: var(--font-display); font-weight: 800; font-size: 1.6rem; margin: 0; }
  </style>
</head>
{% endblock %}

{% block content %}
<main id="main">
  <section class="section" id="top" aria-label="Trade journal">
    <div class="container">
      <div class="sec-head">
        <p class="eyebrow" style="--dot: var(--teal)">Trade Journal</p>
        <h1 class="sec-title">The retest system, <span class="mark">on rails</span></h1>
        <p class="sec-sub">Enter an entry price and get the stop loss at &minus;8%, the take profit at +8% (1:1), and the hard time exit after 40 trading days. Log trades in your own journal — saved on your device, with backup and restore. Aslam&rsquo;s own journal is live below for everyone to watch; only he can write in it.</p>
      </div>

      <div class="tj-wrap">
        <div class="tj-card">
          <div class="tj-typebar">
            <span class="k">Trade type</span>
            <button class="tj-btn on" id="tj-type-stock" type="button">Stock</button>
            <button class="tj-btn" id="tj-type-call" type="button">Call</button>
            <button class="tj-btn" id="tj-type-spread" type="button">Call spread</button>
          </div>
          <div class="tj-form">
            <div class="tj-field">
              <label for="tj-ticker">Ticker</label>
              <input id="tj-ticker" type="text" placeholder="AAPL" autocomplete="off" style="text-transform: uppercase">
            </div>
            <div class="tj-field">
              <label for="tj-entry" id="tj-lbl-entry">Entry price ($)</label>
              <input id="tj-entry" type="number" step="0.01" min="0" placeholder="100.00" inputmode="decimal">
            </div>
            <div class="tj-field">
              <label for="tj-date">Entry date</label>
              <input id="tj-date" type="date">
            </div>
            <div class="tj-field" id="tj-f-amount">
              <label for="tj-amount">Position size ($) — optional</label>
              <input id="tj-amount" type="number" step="1" min="0" placeholder="1000" inputmode="decimal">
            </div>
            <div class="tj-field">
              <label for="tj-cls">Setup class (for the scoreboard)</label>
              <select id="tj-cls">
                <option value="">— not tagged —</option>
                <option value="allfour">&#11088; ALL FOUR — magic + retest + S1 + S2</option>
                <option value="two">Magic setup + retest only (2 of 4)</option>
                <option value="other">Not a system trade</option>
              </select>
            </div>
            <div class="tj-field" id="tj-f-strike" style="display:none">
              <label for="tj-strike" id="tj-lbl-strike">Call strike ($)</label>
              <input id="tj-strike" type="number" step="0.01" min="0" placeholder="100.00" inputmode="decimal">
            </div>
            <div class="tj-field" id="tj-f-strike2" style="display:none">
              <label for="tj-strike2">Sell call strike ($)</label>
              <input id="tj-strike2" type="number" step="0.01" min="0" placeholder="108.00" inputmode="decimal">
            </div>
            <div class="tj-field" id="tj-f-expiry" style="display:none">
              <label for="tj-expiry">Option expiry</label>
              <input id="tj-expiry" type="date">
            </div>
            <div class="tj-field" id="tj-f-premium" style="display:none">
              <label for="tj-premium" id="tj-lbl-premium">Premium paid ($ per contract)</label>
              <input id="tj-premium" type="number" step="0.01" min="0" placeholder="2.50" inputmode="decimal">
            </div>
            <div class="tj-field" id="tj-f-contracts" style="display:none">
              <label for="tj-contracts">Contracts</label>
              <input id="tj-contracts" type="number" step="1" min="1" placeholder="1" inputmode="numeric">
            </div>
          </div>
          <div class="tj-outs">
            <div class="tj-out sl">
              <div class="k">Stop loss · &minus;8%</div>
              <div class="v" id="tj-sl">&mdash;</div>
              <div class="s" id="tj-sl-sub">enter a price</div>
            </div>
            <div class="tj-out tp">
              <div class="k">Take profit · +8% · 1:1</div>
              <div class="v" id="tj-tp">&mdash;</div>
              <div class="s" id="tj-tp-sub">enter a price</div>
            </div>
            <div class="tj-out tm">
              <div class="k">Time exit · 40 trading days</div>
              <div class="v" id="tj-tm">&mdash;</div>
              <div class="s" id="tj-tm-sub">pick an entry date</div>
            </div>
          </div>
          <p class="tj-note" id="tj-opt-note" style="display:none"></p>
          <button class="btn btn-primary tj-add" id="tj-add" type="button">Log this trade</button>
          <p class="tj-note">Rules from the backtest: buy the retest, risk 8%, take 8%, and if the trade goes nowhere, out after 40 trading days. Trading days = days the US market is open: weekends and market holidays (New Year, MLK Day, Presidents Day, Good Friday, Memorial Day, Juneteenth, Independence Day, Labor Day, Thanksgiving, Christmas) do not count toward the 40. Where the trade lands depends on the mode below: your device journal, or Aslam&rsquo;s journal when he is unlocked.</p>
          <p class="tj-note">Playing a setup with options instead of shares? Pick <strong>Call</strong> or <strong>Call spread</strong> under Trade type. The exits still follow the stock &mdash; you close the option when the stock hits its stop, its target, or day 40 &mdash; and the journal shows your real max risk, a Black-Scholes model estimate at the target and the stop, and, once you close, your actual R next to the stock plan&rsquo;s R, so the vehicle&rsquo;s cost is measured, not guessed.</p>
        </div>

        <div class="tj-card">
          <button class="btn btn-primary" id="tj-edge-btn" type="button" style="width:100%">&#128200; Our trading edge &mdash; click here to read</button>
          <div id="tj-edge-body" style="display:none">
            <h3 style="font-family:var(--font-display);font-weight:800;font-size:1.25rem;margin:1.1rem 0 0.2rem">The setup: the Magic Setup</h3>
            <p class="tj-note">A stock coiling under a falling resistance line it has tested at least 3 times over 6 to 10 weeks, while holding above its flat or rising 200-day average. The 6-day and 21-day averages pinch together, RSI sits between 40 and 55, and volume dries up: calm compression under pressure, over a rising floor. A daily close above the line is the trigger.</p>
            <h3 style="font-family:var(--font-display);font-weight:800;font-size:1.25rem;margin:1.1rem 0 0.2rem">The entry: wait for the retest</h3>
            <p class="tj-note">We never chase the trigger. Within 20 trading days, most triggered stocks dip back to the line they broke, touch it, and close back above it &mdash; that close is the entry. On the same 499 trades over five years, entering at the trigger averaged +0.84% per trade; entering at the retest averaged +1.57%. Same stocks, same exits.</p>
            <h3 style="font-family:var(--font-display);font-weight:800;font-size:1.25rem;margin:1.1rem 0 0.2rem">The exits: fixed and mechanical</h3>
            <p class="tj-note">Stop at &minus;8%, target at +8%, and out at 40 trading days whatever the price is. No trailing stops, no early exits, no opinions mid-trade.</p>
            <p class="tj-note">The priority tag: S1 + S2. On the day a setup triggers, two extra facts are checked. <strong>S1 &mdash; volume waking up:</strong> the average daily volume of the last 25 sessions is higher than the 25 sessions before them. <strong>S2 &mdash; price still lagging:</strong> over the 50 sessions into the trigger, the stock has gained less than the S&amp;P 500. A trade that carries both, on top of the setup and the retest, is <strong>ALL FOUR</strong> &mdash; and every Telegram alert now labels which kind it is. In the same 499 trades, 130 were ALL FOUR: they averaged <strong>+3.13% per trade</strong> against +1.57% for the whole set, won <strong>70%</strong> of the time against 60%, and were stopped out on 21% of exits against 31%. The wins were the same size &mdash; there were simply fewer losers. Modelled options on the tagged trades: calls +24.18% and spreads +21.91% per trade, against +11.18% and +10.18% overall.</p>
            <p class="tj-note">Two honest limits on the tag. It was found by studying these same 499 trades, so some of its shine may be hindsight; the live record &mdash; every new alert carries its label &mdash; is the real test. And it is a priority label, not a filter: only about 30 ALL FOUR trades appear a year, so an account trading nothing else sat in cash too often and made less overall ($15,082 against $18,358 on $10,000 in the stock simulation). Its job is narrower: when two signals compete for one slot, the ALL FOUR goes first.</p>
            <h3 style="font-family:var(--font-display);font-weight:800;font-size:1.25rem;margin:1.1rem 0 0.2rem">The evidence: five years, 499 trades (Oct 2021 &ndash; Oct 2026)</h3>
            <p class="tj-note">Stocks at real prices: 499 retest trades, 60% positive (249 hit target, 154 stopped out, 96 timed out), average +1.57% per trade, and a flat $1,000 on every trade returned +$7,849 with no losing year &mdash; including the 2022 bear market. The rules above are the whole system; tighter bands, shorter holds, trailing stops and shorting the mirror image were all tested on the same data and all made it worse.</p>
            <h3 style="font-family:var(--font-display);font-weight:800;font-size:1.25rem;margin:1.1rem 0 0.2rem">The options version: $10,000 simulations</h3>
            <p class="tj-note">Same signals and exits, traded with ~90-day at-the-money calls, or as call spreads (buy the at-the-money call, sell the call 8% higher) &mdash; the spread is the version sized for small accounts, because it roughly halves the ticket and caps the loss at the amount paid. Simulated on the real sequence of the same 499 trades, in date order, $10,000 starting capital:</p>
            <div class="tj-outs">
              <div class="tj-out tp">
                <div class="k">Stocks &middot; real prices</div>
                <div class="v">+83.6%</div>
                <div class="s">$10,000 &rarr; $18,358 &middot; 8 slots of $1,250 &middot; worst dip &minus;12.1%</div>
              </div>
              <div class="tj-out tm">
                <div class="k">Call spreads &middot; modeled</div>
                <div class="v">+633.8%</div>
                <div class="s">$10,000 &rarr; $73,377 &middot; 4 slots of $2,500 &middot; worst dip &minus;36.1%</div>
              </div>
              <div class="tj-out sl">
                <div class="k">Naked calls &middot; modeled</div>
                <div class="v">+680.7%</div>
                <div class="s">$10,000 &rarr; $78,067 &middot; 8 slots of $1,250 &middot; worst dip &minus;47.1%</div>
              </div>
            </div>
            <p class="tj-note">Read the labels. The stock numbers come from real market prices. The options numbers are simulations priced with the Black-Scholes model &mdash; volatility held at its entry level and no bid-ask spread charged &mdash; so treat them as a best-case sketch, not a promise: real fills cost the spread on every trade, slow trades bleed time value, and the worst dips above are deeper than the stock version&rsquo;s. A simulation of the last five years is evidence about a system, never a guarantee about the next five.</p>
          </div>
        </div>

        <div class="tj-jhead">
          <h2 id="tj-mine-title">Your journal · this device</h2>
          <button class="tj-btn" id="tj-lock" type="button">I&rsquo;m Aslam — unlock my journal</button>
          <button class="tj-btn" id="tj-export" type="button">Download backup</button>
          <button class="tj-btn" id="tj-import" type="button">Restore from backup</button>
          <input type="file" id="tj-file" accept=".json,application/json" style="display:none">
        </div>
        <div class="tj-stats" id="tj-stats"></div>
        <div class="tj-score" id="tj-score-mine"></div>
        <div id="tj-list"></div>
        <div class="tj-empty" id="tj-empty">No trades logged yet. Your first trade will live here.</div>
        <p class="tj-note" id="tj-mine-note">Your journal is saved in this browser on this device only — nobody else can see it, and nothing is uploaded. Switching devices? Download a backup here, then restore it on the new device.</p>

        <div id="tj-aslam-sec">
          <div class="tj-jhead">
            <h2>Aslam&rsquo;s journal · live</h2>
          </div>
          <div class="tj-stats" id="tj-aslam-stats"></div>
          <div class="tj-score" id="tj-score"></div>
          <div id="tj-aslam-list"></div>
          <div class="tj-empty" id="tj-aslam-empty">Loading Aslam&rsquo;s journal&hellip;</div>
          <p class="tj-note">Aslam&rsquo;s journal lives on his own server — the same on his phone and his laptop. Everyone can watch it; only Aslam can write in it.</p>
        </div>

        <div class="tj-jhead">
          <h2>Veto log — trades the system called and Aslam skipped</h2>
        </div>
        <p class="tj-note">A veto is a trade the system pinged that Aslam decided not to take. Each veto is logged with the would-be entry (ticker, entry price, date, and his reason), and the log grades it automatically under the same −8% / +8% / 40-trading-day rules: if the skipped trade would have made money, the veto cost money; if it would have lost, the veto saved money. Still-open vetoes re-grade as prices move; finished grades are final.</p>
        <p class="tj-note" id="tj-veto-hint"><strong>Want to log a veto?</strong> First tap &ldquo;I&rsquo;m Aslam — unlock my journal&rdquo; at the top of this page and enter your PIN — the log form then appears right here. Same PIN as your journal.</p>
        <div id="tj-veto-open" style="display:none">
          <div class="tj-form">
            <div class="tj-field">
              <label for="tj-v-ticker">Ticker</label>
              <input id="tj-v-ticker" type="text" placeholder="AAPL" autocomplete="off" style="text-transform: uppercase">
            </div>
            <div class="tj-field">
              <label for="tj-v-entry">Entry price ($) the system called</label>
              <input id="tj-v-entry" type="number" step="0.01" min="0" placeholder="100.00" inputmode="decimal">
            </div>
            <div class="tj-field">
              <label for="tj-v-date">Signal date</label>
              <input id="tj-v-date" type="date">
            </div>
            <div class="tj-field">
              <label for="tj-v-reason">Reason he skipped it</label>
              <input id="tj-v-reason" type="text" placeholder="e.g. earnings tomorrow" autocomplete="off">
            </div>
          </div>
          <button class="btn btn-primary" id="tj-veto-add" type="button">Log veto</button>
        </div>
        <div class="tj-stats" id="tj-veto-stats"></div>
        <div id="tj-veto-list"></div>
        <div class="tj-empty" id="tj-veto-empty">Loading the veto log&hellip;</div>
        <p class="tj-note">Verdict so far shows whether Aslam&rsquo;s vetoes, as a group, are making or costing money versus just taking every system trade. Net is per $1,000 position, summed over graded vetoes.</p>
      </div>
    </div>
  </section>
</main>

<script>
(function () {
  var HOLD = 40;
  var API = "https://129-146-179-218.sslip.io/trade-journal-api";
  var PIN_KEY = "tj-pin";
  var LOCAL_KEY = "tj-entries-v1";
  var $ = function (id) { return document.getElementById(id); };
  var tickerEl = $("tj-ticker"), entryEl = $("tj-entry"), dateEl = $("tj-date"),
      amountEl = $("tj-amount"), slEl = $("tj-sl"), tpEl = $("tj-tp"),
      tmEl = $("tj-tm"), slSub = $("tj-sl-sub"), tpSub = $("tj-tp-sub"),
      tmSub = $("tj-tm-sub"), lockBtn = $("tj-lock"),
      mineTitle = $("tj-mine-title"), mineNote = $("tj-mine-note"),
      aslamSec = $("tj-aslam-sec"), clsEl = $("tj-cls");
  var serverRows = null;
  var serverError = false;
  var vetoData = null;
  var vetoError = false;
  var watchMap = {};
  var jtype = "stock";
  var strikeEl = $("tj-strike"), strike2El = $("tj-strike2"),
      expiryEl = $("tj-expiry"), premiumEl = $("tj-premium"),
      contractsEl = $("tj-contracts"), optNote = $("tj-opt-note");

  function pin() { return localStorage.getItem(PIN_KEY) || ""; }
  function unlocked() { return !!pin(); }

  function todayLocal() {
    var d = new Date();
    return d.getFullYear() + "-" + String(d.getMonth() + 1).padStart(2, "0") + "-" + String(d.getDate()).padStart(2, "0");
  }
  function parseDate(s) {
    var p = s.split("-");
    return new Date(Number(p[0]), Number(p[1]) - 1, Number(p[2]));
  }
  function fmtDate(d) {
    return d.toLocaleDateString("en-US", { weekday: "short", month: "short", day: "numeric", year: "numeric" });
  }
  function money(x) {
    return "$" + x.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }
  // NYSE full-day holidays, generated by rule for any year (with weekend observance):
  // New Year, MLK Day, Presidents Day, Good Friday, Memorial Day, Juneteenth,
  // Independence Day, Labor Day, Thanksgiving, Christmas.
  function easterSunday(y) {
    var a = y % 19, b = Math.floor(y / 100), c = y % 100,
        q = Math.floor(b / 4), e = b % 4, f = Math.floor((b + 8) / 25),
        g = Math.floor((b - f + 1) / 3), h = (19 * a + b - q - g + 15) % 30,
        i = Math.floor(c / 4), k = c % 4, l = (32 + 2 * e + 2 * i - h - k) % 7,
        m = Math.floor((a + 11 * h + 22 * l) / 451),
        mo = Math.floor((h + l - 7 * m + 114) / 31), dy = ((h + l - 7 * m + 114) % 31) + 1;
    return new Date(y, mo - 1, dy);
  }
  function nthWeekday(y, mo, wd, n) {
    var d = new Date(y, mo, 1);
    return new Date(y, mo, 1 + ((wd - d.getDay() + 7) % 7) + (n - 1) * 7);
  }
  function lastWeekday(y, mo, wd) {
    var d = new Date(y, mo + 1, 0);
    return new Date(y, mo, d.getDate() - ((d.getDay() - wd + 7) % 7));
  }
  var holidayCache = {};
  function nyseHolidays(y) {
    if (holidayCache[y]) return holidayCache[y];
    var set = {};
    function add(d) { set[d.getFullYear() + "-" + d.getMonth() + "-" + d.getDate()] = true; }
    function observedFixed(yy, mo, dy) {
      var d = new Date(yy, mo, dy), w = d.getDay();
      if (w === 6) d.setDate(d.getDate() - 1); else if (w === 0) d.setDate(d.getDate() + 1);
      return d;
    }
    add(observedFixed(y, 0, 1));      // New Year
    add(nthWeekday(y, 0, 1, 3));      // MLK Day: 3rd Mon Jan
    add(nthWeekday(y, 1, 1, 3));      // Presidents Day: 3rd Mon Feb
    var gf = easterSunday(y); gf.setDate(gf.getDate() - 2); add(gf); // Good Friday
    add(lastWeekday(y, 4, 1));        // Memorial Day: last Mon May
    add(observedFixed(y, 5, 19));     // Juneteenth
    add(observedFixed(y, 6, 4));      // Independence Day
    add(nthWeekday(y, 8, 1, 1));      // Labor Day: 1st Mon Sep
    add(nthWeekday(y, 10, 4, 4));     // Thanksgiving: 4th Thu Nov
    add(observedFixed(y, 11, 25));    // Christmas
    if (new Date(y + 1, 0, 1).getDay() === 6) add(new Date(y, 11, 31)); // next Jan 1 Sat -> observed Fri Dec 31
    holidayCache[y] = set;
    return set;
  }
  function isHoliday(d) {
    return !!nyseHolidays(d.getFullYear())[d.getFullYear() + "-" + d.getMonth() + "-" + d.getDate()];
  }
  function isTradingDay(d) { var w = d.getDay(); return w >= 1 && w <= 5 && !isHoliday(d); }
  function addTradingDays(start, n) {
    var d = new Date(start.getTime()), added = 0;
    while (added < n) { d.setDate(d.getDate() + 1); if (isTradingDay(d)) added++; }
    return d;
  }
  function tradingDaysElapsed(from, to) {
    var d = new Date(from.getTime()), n = 0;
    while (d < to) { d.setDate(d.getDate() + 1); if (isTradingDay(d) && d <= to) n++; }
    return n;
  }
  function daysLeft(e) {
    var start = parseDate(e.date);
    var end = new Date(); end.setHours(0, 0, 0, 0);
    if (end <= start) return HOLD;
    return HOLD - tradingDaysElapsed(start, end);
  }

  /* ---------- options math (Black-Scholes, same model as the backtests: r = 4%) ---------- */
  function erf(x) {
    var s = x < 0 ? -1 : 1; x = Math.abs(x);
    var t = 1 / (1 + 0.3275911 * x);
    var y = 1 - (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * Math.exp(-x * x);
    return s * y;
  }
  function ncdf(x) { return 0.5 * (1 + erf(x / Math.SQRT2)); }
  function bsCall(S, K, T, sigma) {
    if (T <= 0 || sigma <= 0) return Math.max(S - K, 0);
    var d1 = (Math.log(S / K) + (0.04 + sigma * sigma / 2) * T) / (sigma * Math.sqrt(T));
    var d2 = d1 - sigma * Math.sqrt(T);
    return S * ncdf(d1) - K * Math.exp(-0.04 * T) * ncdf(d2);
  }
  function isOpt(e) { return e && (e.jtype === "call" || e.jtype === "spread"); }
  function optPrice(o, S, T, sigma) {
    var v = bsCall(S, o.strike, T, sigma);
    if (o.jtype === "spread") v -= bsCall(S, o.strike2, T, sigma);
    return Math.max(0, v);
  }
  function yearsBetween(d1, d2) { return (parseDate(d2) - parseDate(d1)) / 86400000 / 365; }
  function impliedSigma(o) {
    var T = yearsBetween(o.date, o.expiry);
    if (!(T > 0) || !(o.premium > 0) || !(o.strike > 0)) return null;
    if (o.jtype === "spread" && !(o.strike2 > o.strike)) return null;
    // A spread's value is not monotone in vol, so scan for the first
    // bracket where the model price crosses the premium paid, then
    // bisect inside it (the lowest-vol root is the sane regime).
    var prevS = 0.02, prevP = optPrice(o, o.entry, T, prevS) - o.premium;
    if (prevP === 0) return prevS;
    for (var s = 0.04; s <= 2.5001; s += 0.02) {
      var p = optPrice(o, o.entry, T, s) - o.premium;
      if (p === 0) return s;
      if ((p < 0) !== (prevP < 0)) {
        var lo = prevS, hi = s, negLo = prevP < 0;
        for (var i = 0; i < 50; i++) {
          var mid = (lo + hi) / 2;
          var fm = optPrice(o, o.entry, T, mid) - o.premium;
          if ((fm < 0) === negLo) lo = mid; else hi = mid;
        }
        return (lo + hi) / 2;
      }
      prevS = s; prevP = p;
    }
    return null;
  }
  // Model estimate: what the contract would be worth if the stock
  // reaches its target / stop with the move taking ~2 weeks, vol
  // implied by the premium paid and held there. A model, not a quote.
  function modelEst(o) {
    var sig = impliedSigma(o);
    if (!sig) return null;
    var T1 = Math.max(yearsBetween(o.date, o.expiry) - 15 / 365, 0);
    return { sigma: sig, tp: optPrice(o, o.entry * 1.08, T1, sig), sl: optPrice(o, o.entry * 0.92, T1, sig) };
  }
  function fmtR(x) { return (x >= 0 ? "+" : "−") + Math.abs(x).toFixed(2) + "R"; }
  function pctTxt(x) { return (x >= 0 ? "+" : "−") + Math.abs(x).toFixed(0) + "%"; }

  function setType(t) {
    jtype = t;
    $("tj-type-stock").classList.toggle("on", t === "stock");
    $("tj-type-call").classList.toggle("on", t === "call");
    $("tj-type-spread").classList.toggle("on", t === "spread");
    var opt = t !== "stock";
    $("tj-f-amount").style.display = opt ? "none" : "";
    $("tj-f-strike").style.display = opt ? "" : "none";
    $("tj-f-strike2").style.display = t === "spread" ? "" : "none";
    $("tj-f-expiry").style.display = opt ? "" : "none";
    $("tj-f-premium").style.display = opt ? "" : "none";
    $("tj-f-contracts").style.display = opt ? "" : "none";
    optNote.style.display = opt ? "" : "none";
    $("tj-lbl-entry").textContent = opt ? "Stock entry price ($) — the retest close" : "Entry price ($)";
    $("tj-lbl-strike").textContent = t === "spread" ? "Buy call strike ($)" : "Call strike ($)";
    $("tj-lbl-premium").textContent = t === "spread" ? "Net debit ($ per spread)" : "Premium paid ($ per contract)";
    calc();
  }

  function calc() {
    var p = parseFloat(entryEl.value);
    var amt = parseFloat(amountEl.value);
    if (!p || p <= 0) {
      slEl.textContent = tpEl.textContent = "—";
      slSub.textContent = tpSub.textContent = "enter a price";
    } else {
      var sl = p * 0.92, tp = p * 1.08;
      slEl.textContent = money(sl);
      tpEl.textContent = money(tp);
      slSub.textContent = "sell if it falls to here · loses " + money(p - sl) + "/share" + (amt > 0 ? " · " + money(amt * 0.08) + " on your size" : "");
      tpSub.textContent = "sell if it rises to here · makes " + money(tp - p) + "/share" + (amt > 0 ? " · " + money(amt * 0.08) + " on your size" : "");
    }
    if (dateEl.value) {
      var exit = addTradingDays(parseDate(dateEl.value), HOLD);
      tmEl.textContent = exit.toLocaleDateString("en-US", { month: "short", day: "numeric" });
      tmSub.textContent = "exit by " + fmtDate(exit) + " if it goes nowhere";
    } else {
      tmEl.textContent = "—";
      tmSub.textContent = "pick an entry date";
    }
    if (jtype !== "stock") {
      var o = {
        jtype: jtype, entry: p, date: dateEl.value || todayLocal(),
        strike: parseFloat(strikeEl.value), strike2: parseFloat(strike2El.value),
        expiry: expiryEl.value, premium: parseFloat(premiumEl.value)
      };
      var n = parseInt(contractsEl.value, 10);
      if (o.premium > 0 && n >= 1) {
        var txt = "Options math — max risk " + money(o.premium * n * 100) +
          " (" + n + " contract" + (n === 1 ? "" : "s") + " × " + money(o.premium) + ").";
        var m = (o.entry > 0 && o.expiry) ? modelEst(o) : null;
        if (m) {
          txt += " Model estimate (Black-Scholes, vol " + Math.round(m.sigma * 100) +
            "% implied by your premium, move over ~2 weeks): at the stock's target the " +
            (jtype === "spread" ? "spread" : "contract") + " ≈ " + money(m.tp) +
            " (" + pctTxt((m.tp / o.premium - 1) * 100) + ") · at the stop ≈ " + money(m.sl) +
            " (" + pctTxt((m.sl / o.premium - 1) * 100) + "). A model, not a quote — real prices differ." +
            " Exits still follow the stock: close the option when the stock hits its stop, its target, or day 40.";
        } else {
          txt += " Fill the stock entry, strike" + (jtype === "spread" ? "s" : "") +
            " and expiry to see the model estimate.";
        }
        optNote.textContent = txt;
      } else {
        optNote.textContent = "Options math — fill the premium and contracts to see your max risk. " +
          "The plan's exits stay on the stock: you close the option when the stock hits −8%, +8%, or day 40 — " +
          "the option's own % is never the trigger.";
      }
    }
  }

  /* ---------- local (device) journal ---------- */
  function loadLocal() {
    try { return JSON.parse(localStorage.getItem(LOCAL_KEY)) || []; }
    catch (err) { return []; }
  }
  function saveLocal(rows) { localStorage.setItem(LOCAL_KEY, JSON.stringify(rows)); }

  /* ---------- server (Aslam) journal ---------- */
  function fetchServer() {
    return fetch(API + "/journal").then(function (r) { return r.json(); }).then(function (data) {
      serverRows = Array.isArray(data.entries) ? data.entries : [];
      serverError = false;
      renderAll();
      fetchStatus();
    }).catch(function () {
      serverRows = null;
      serverError = true;
      renderAll();
    });
  }
  function fetchStatus() {
    return fetch(API + "/status").then(function (r) { return r.json(); }).then(function (data) {
      watchMap = (data && data.statuses) || {};
      (serverRows || []).forEach(function (e) {
        var w = watchMap[String(e.id)];
        if (w) e._watch = w; else if (e._watch) delete e._watch;
      });
      renderAll();
    }).catch(function () { /* the watch is a bonus layer; the journal renders without it */ });
  }
  function mutate(payload) {
    payload.pin = pin();
    return fetch(API + "/mutate", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload)
    }).then(function (r) {
      return r.json().then(function (data) {
        if (r.status === 401) {
          localStorage.removeItem(PIN_KEY);
          renderAll();
          throw new Error("Wrong PIN — journal locked again.");
        }
        if (!r.ok) throw new Error(data.error || "Something went wrong.");
        return data;
      });
    });
  }

  /* ---------- shared rendering ---------- */
  function esc(s) {
    return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) {
      return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
    });
  }
  function renderVetoes() {
    var listEl = $("tj-veto-list"), emptyEl = $("tj-veto-empty"), statsEl = $("tj-veto-stats");
    $("tj-veto-open").style.display = unlocked() ? "block" : "none";
    $("tj-veto-hint").style.display = unlocked() ? "none" : "block";
    if (vetoError) {
      statsEl.textContent = "";
      listEl.innerHTML = "";
      emptyEl.style.display = "block";
      emptyEl.textContent = "The veto log could not load right now — try refreshing in a minute.";
      return;
    }
    if (!vetoData) {
      emptyEl.style.display = "block";
      emptyEl.textContent = "Loading the veto log…";
      return;
    }
    var rows = vetoData.vetoes || [], s = vetoData.summary || {};
    emptyEl.style.display = rows.length === 0 ? "block" : "none";
    if (rows.length === 0) emptyEl.textContent = "No vetoes yet — the first skipped trade will live here.";
    if (!s.graded) {
      statsEl.textContent = rows.length ? "No finished vetoes yet — grades appear once a skipped trade hits its stop, target, or the 40-day exit." : "";
    } else {
      var net = s.netPer1000;
      statsEl.textContent = "Graded: " + s.graded +
        " · veto saved money: " + s.saved +
        " · veto cost money: " + s.cost +
        " · net effect: " + (net >= 0 ? "+" : "−") + "$" + Math.abs(net).toLocaleString("en-US") +
        " per $1,000 — vetoes are " + (net >= 0 ? "MAKING money" : "COSTING money") + " so far";
    }
    var sorted = rows.slice().sort(function (a, b) {
      var ao = a.grade && a.grade.status === "open", bo = b.grade && b.grade.status === "open";
      if (ao !== bo) return ao ? -1 : 1;
      return (b.createdAt || 0) - (a.createdAt || 0);
    });
    listEl.innerHTML = "";
    sorted.forEach(function (v) {
      var card = document.createElement("div");
      card.className = "tj-entry";
      var html = '<div class="tj-row1">' +
        '<span class="tj-tick">' + esc(v.ticker) + '</span>' +
        '<span class="tj-nums">Vetoed entry ' + money(v.entry) + '</span>' +
        '<span class="tj-date">signal ' + fmtDate(parseDate(v.date)) + '</span>' +
        '<span class="tj-badge time">VETO</span>';
      if (unlocked()) html += '<button class="tj-btn danger tj-del" data-vdel="' + v.id + '" type="button">Delete</button>';
      html += '</div>';
      if (v.reason) html += '<div class="tj-days">Reason: ' + esc(v.reason) + '</div>';
      var g = v.grade || {};
      if (g.status === "target") {
        html += '<div class="tj-days"><span class="r">Would have WON +8.0%</span> · target hit ' + fmtDate(parseDate(g.exitDate)) + ' in ' + g.days + ' trading days · this veto cost $80 per $1,000</div>';
      } else if (g.status === "stop") {
        html += '<div class="tj-days"><span class="g">Would have LOST −8.0%</span> · stop hit ' + fmtDate(parseDate(g.exitDate)) + ' in ' + g.days + ' trading days · this veto saved $80 per $1,000</div>';
      } else if (g.status === "timeout") {
        var pctTxt = (g.resultPct >= 0 ? "+" : "−") + Math.abs(g.resultPct).toFixed(1) + "%";
        var usd = "$" + Math.abs(Math.round(g.resultPct * 10)).toLocaleString("en-US");
        html += '<div class="tj-days">Would have timed out at <span class="' + (g.resultPct >= 0 ? "r" : "g") + '">' + pctTxt + '</span> · exited ' + fmtDate(parseDate(g.exitDate)) + ' after 40 trading days · this veto ' + (g.resultPct >= 0 ? "cost " : "saved ") + usd + ' per $1,000</div>';
      } else if (g.status === "open") {
        html += '<div class="tj-days">Still open · ' + g.days + ' trading days in' +
          (typeof g.resultPct === "number" ? ' · at ' + (g.resultPct >= 0 ? "+" : "−") + Math.abs(g.resultPct).toFixed(1) + '% if exited at the last close' : ' · no sessions yet since the signal') + '</div>';
      } else {
        html += '<div class="tj-days">Grade unavailable right now.</div>';
      }
      card.innerHTML = html;
      listEl.appendChild(card);
    });
  }
  function fetchVetoes() {
    return fetch(API + "/vetoes").then(function (r) { return r.json(); }).then(function (data) {
      vetoData = data;
      vetoError = false;
      renderVetoes();
    }).catch(function () {
      vetoData = null;
      vetoError = true;
      renderVetoes();
    });
  }

  function barClass(left) { return left <= 10 ? "r" : (left <= 20 ? "y" : "g"); }

  function statsText(rows) {
    var active = rows.filter(function (r) { return r.status === "active"; }).length;
    var won = rows.filter(function (r) { return r.status === "won"; }).length;
    var lost = rows.filter(function (r) { return r.status === "lost"; }).length;
    var timed = rows.filter(function (r) { return r.status === "time"; }).length;
    var closed = won + lost + timed;
    return rows.length === 0 ? "" :
      "Active: " + active + " · Won: " + won + " · Lost: " + lost + " · Time exits: " + timed +
      (closed > 0 ? " · Win rate: " + Math.round(won / closed * 100) + "%" : "");
  }

  function buildCard(e, editable, onAction) {
    var sl = e.entry * 0.92, tp = e.entry * 1.08;
    var exitBy = addTradingDays(parseDate(e.date), HOLD);
    var card = document.createElement("div");
    card.className = "tj-entry";
    var html = '<div class="tj-row1">' +
      '<span class="tj-tick">' + e.ticker + '</span>' +
      '<span class="tj-nums">Entry ' + money(e.entry) + ' · <span class="sl">SL ' + money(sl) + '</span> · <span class="tp">TP ' + money(tp) + '</span></span>' +
      '<span class="tj-date">in ' + fmtDate(parseDate(e.date)) + '</span>';
    if (e.status === "won") html += '<span class="tj-badge won">Won</span>';
    if (e.status === "lost") html += '<span class="tj-badge lost">Lost</span>';
    if (e.status === "time") html += '<span class="tj-badge time">Time exit</span>';
    if (isOpt(e)) html += '<span class="tj-badge">' + (e.jtype === "call" ? "Call" : "Spread") + '</span>';
    if (e.cls === "allfour") html += '<span class="tj-badge">&#11088; ALL FOUR</span>';
    else if (e.cls === "two") html += '<span class="tj-badge">2 of 4</span>';
    if (typeof e.exitPrice === "number") {
      var pct = (e.exitPrice / e.entry - 1) * 100;
      html += '<span class="tj-nums">out ' + money(e.exitPrice) + ' (' + (pct >= 0 ? "+" : "") + pct.toFixed(1) + '%)</span>';
    }
    if (editable) html += '<button class="tj-btn danger tj-del" data-act="del" type="button">Delete</button>';
    html += '</div>';
    if (isOpt(e)) {
      var risk = (typeof e.premium === "number" && typeof e.contracts === "number") ? e.premium * e.contracts * 100 : null;
      var ol = '<div class="tj-days">';
      if (e.jtype === "call") {
        ol += 'Call ' + money(e.strike || 0) + ' · exp ' + (e.expiry ? fmtDate(parseDate(e.expiry)) : "—");
      } else {
        ol += 'Spread buy ' + money(e.strike || 0) + ' / sell ' + money(e.strike2 || 0) + ' · exp ' + (e.expiry ? fmtDate(parseDate(e.expiry)) : "—");
      }
      if (typeof e.premium === "number") ol += ' · paid ' + money(e.premium) + (e.jtype === "spread" ? "/spread" : "/contract");
      if (typeof e.contracts === "number") ol += ' · ' + e.contracts + ' contract' + (e.contracts === 1 ? "" : "s");
      if (risk !== null) ol += ' · <strong>max risk ' + money(risk) + '</strong>';
      ol += '</div>';
      var mm0 = modelEst(e);
      if (mm0 && typeof e.premium === "number" && e.premium > 0) {
        ol += '<div class="tj-days">Model: at target ≈ ' + money(mm0.tp) + ' (' + pctTxt((mm0.tp / e.premium - 1) * 100) +
          ') · at stop ≈ ' + money(mm0.sl) + ' (' + pctTxt((mm0.sl / e.premium - 1) * 100) +
          ') — Black-Scholes estimate from your premium, not a quote</div>';
      }
      if (typeof e.exitPremium === "number" && typeof e.premium === "number" && e.premium > 0) {
        var aR = (e.exitPremium - e.premium) / e.premium;
        var pR = e.status === "won" ? 1 : e.status === "lost" ? -1 :
          (typeof e.exitPrice === "number" ? (e.exitPrice / e.entry - 1) / 0.08 : null);
        ol += '<div class="tj-days">Option out ' + money(e.exitPremium) + ' · actual ' + fmtR(aR) +
          (pR !== null ? ' vs stock plan ' + fmtR(pR) + ' · vehicle difference ' + fmtR(aR - pR) : '') + '</div>';
      }
      html += ol;
    }
    if (e.status === "active") {
      var left = daysLeft(e);
      var cls = barClass(Math.max(left, 0));
      var pctW = Math.max(0, Math.min(100, left / HOLD * 100));
      html += '<div class="tj-bar"><div class="' + cls + '" style="width:' + pctW + '%"></div></div>';
      if (left > 0) {
        html += '<div class="tj-days"><span class="' + cls + '">' + left + ' trading day' + (left === 1 ? "" : "s") + ' left</span> · time exit ' + fmtDate(exitBy) + '</div>';
      } else {
        html += '<div class="tj-days"><span class="r">TIME UP — exit this trade</span> · 40 trading days passed on ' + fmtDate(exitBy) + '</div>';
      }
      if (e._watch) {
        var w = e._watch;
        html += '<div class="tj-days">&#128225; Last close ' + money(w.lastClose) + ' <span class="tj-date">(' + fmtDate(parseDate(w.lastDate)) + ')</span> · ' +
          (w.pctNow >= 0 ? '+' : '') + w.pctNow.toFixed(1) + '% from entry · ' + w.toStopPct.toFixed(1) + '% above the stop · ' + w.toTargetPct.toFixed(1) + '% to the target</div>';
        if (w.state === "target") html += '<div class="tj-days"><span class="g">&#127919; Target touched on ' + fmtDate(parseDate(w.hitDate)) + ' — the plan says this trade is done</span></div>';
        if (w.state === "stop") html += '<div class="tj-days"><span class="r">&#128308; Stop touched on ' + fmtDate(parseDate(w.hitDate)) + ' — the plan says this trade is done</span></div>';
        if (w.earnings) html += '<div class="tj-days">&#9888;&#65039; Earnings ' + fmtDate(parseDate(w.earnings.date)) + (w.earnings.when ? ' (' + w.earnings.when + ')' : '') + ' — inside this trade&rsquo;s hold</div>';
      }
      if (editable) {
        html += '<div class="tj-actions">' +
          '<button class="tj-btn" data-act="won" type="button">Hit TP ✓</button>' +
          '<button class="tj-btn" data-act="lost" type="button">Hit SL ✗</button>' +
          '<button class="tj-btn" data-act="time" type="button">Time exit</button></div>' +
          '<div class="tj-close"><span class="tj-date">' + (isOpt(e) ? "Stock exit:" : "Exit price:") + '</span>' +
          '<input class="tj-xs" type="number" step="0.01" min="0" inputmode="decimal">' +
          (isOpt(e) ? '<span class="tj-date">Option exit ($/contract):</span>' +
            '<input class="tj-xo" type="number" step="0.01" min="0" inputmode="decimal">' : '') +
          '<button class="tj-btn" data-act="saveclose" type="button">Save</button>' +
          '<button class="tj-btn" data-act="cancelclose" type="button">Cancel</button></div>';
      }
    }
    card.innerHTML = html;
    if (editable && onAction) {
      var closeBox = card.querySelector(".tj-close");
      var pending = null;
      card.addEventListener("click", function (ev) {
        var btn = ev.target.closest("button");
        if (!btn) return;
        var act = btn.getAttribute("data-act");
        if (act === "del") {
          if (confirm("Delete " + e.ticker + " from the journal?")) onAction("delete", e, null);
        } else if (act === "won" || act === "lost" || act === "time") {
          pending = act;
          var inp = closeBox.querySelector(".tj-xs");
          inp.value = act === "won" ? (e.entry * 1.08).toFixed(2) : act === "lost" ? (e.entry * 0.92).toFixed(2) : e.entry.toFixed(2);
          var oi = closeBox.querySelector(".tj-xo");
          if (oi) {
            var mm2 = modelEst(e);
            oi.value = act === "won" && mm2 ? mm2.tp.toFixed(2) : act === "lost" && mm2 ? mm2.sl.toFixed(2) : "";
          }
          closeBox.classList.add("open");
          inp.focus(); inp.select();
        } else if (act === "saveclose") {
          var v = parseFloat(closeBox.querySelector(".tj-xs").value);
          var data = { status: pending || "time", exitPrice: v > 0 ? v : null };
          var oi2 = closeBox.querySelector(".tj-xo");
          if (oi2) {
            var raw = oi2.value.trim();
            var ov = raw === "" ? null : parseFloat(raw);
            data.exitPremium = (ov !== null && ov >= 0) ? ov : null;
          }
          onAction("close", e, data);
        } else if (act === "cancelclose") {
          closeBox.classList.remove("open");
          pending = null;
        }
      });
    }
    return card;
  }

  function fillList(listEl, emptyEl, rows, editable, onAction, emptyText) {
    var sorted = rows.slice().sort(function (a, b) {
      if ((a.status === "active") !== (b.status === "active")) return a.status === "active" ? -1 : 1;
      return b.createdAt - a.createdAt;
    });
    emptyEl.style.display = rows.length === 0 ? "block" : "none";
    if (rows.length === 0) emptyEl.textContent = emptyText;
    listEl.innerHTML = "";
    sorted.forEach(function (e) { listEl.appendChild(buildCard(e, editable, onAction)); });
  }

  /* ---------- actions per mode ---------- */
  function localAction(act, e, data) {
    var rows = loadLocal();
    if (act === "delete") {
      saveLocal(rows.filter(function (r) { return r.id !== e.id; }));
    } else if (act === "close") {
      rows.forEach(function (r) {
        if (r.id === e.id) {
          r.status = data.status;
          if (data.exitPrice) r.exitPrice = data.exitPrice;
          if (data.exitPremium != null) r.exitPremium = data.exitPremium;
        }
      });
      saveLocal(rows);
    }
    renderAll();
  }
  function serverAction(act, e, data) {
    var p = act === "delete"
      ? mutate({ action: "delete", id: e.id })
      : mutate({ action: "close", id: e.id, status: data.status, exitPrice: data.exitPrice, exitPremium: data.exitPremium });
    p.then(fetchServer).catch(function (err) { alert(err.message); });
  }

  /* ---------- scoreboard: live record vs the backtest ---------- */
  var BT = {
    all: { win: 60, r: 0.20, stop: 31, n: 499 },
    allfour: { win: 70, r: 0.39, stop: 21, n: 130 },
    two: { win: 57, r: 0.13, stop: 34, n: 369 }
  };
  function tradeMetrics(e) {
    var planR = e.status === "won" ? 1 : e.status === "lost" ? -1 :
      (typeof e.exitPrice === "number" && e.entry > 0 ? (e.exitPrice / e.entry - 1) / 0.08 : null);
    var pnl = null, r = planR, win = null;
    if (isOpt(e) && typeof e.premium === "number" && e.premium > 0 &&
        typeof e.contracts === "number" && typeof e.exitPremium === "number") {
      pnl = (e.exitPremium - e.premium) * e.contracts * 100;
      r = (e.exitPremium - e.premium) / e.premium;
      win = pnl > 0;
    } else if (typeof e.amount === "number" && typeof e.exitPrice === "number" && e.entry > 0) {
      pnl = (e.exitPrice / e.entry - 1) * e.amount;
      win = pnl > 0;
    }
    if (win === null) win = planR !== null ? planR > 0 : e.status === "won";
    return { pnl: pnl, r: r, win: win, stop: e.status === "lost" };
  }
  function scoreGroup(rows) {
    var n = rows.length, wins = 0, stops = 0, rSum = 0, rN = 0, pnl = 0, pnlN = 0;
    rows.forEach(function (e) {
      var m = tradeMetrics(e);
      if (m.win) wins++;
      if (m.stop) stops++;
      if (m.r !== null) { rSum += m.r; rN++; }
      if (m.pnl !== null) { pnl += m.pnl; pnlN++; }
    });
    return { n: n, win: n ? Math.round(wins / n * 100) : null,
      avgR: rN ? rSum / rN : null, stop: n ? Math.round(stops / n * 100) : null,
      pnl: pnlN ? pnl : null };
  }
  function scoreLine(label, g, bt) {
    if (g.n === 0) return '<div>' + label + ' — no closed trades yet' +
      (bt ? ' <span class="dim">· backtest: ' + bt.win + '% win · ' + fmtR(bt.r) + ' avg · ' + bt.stop + '% stops (' + bt.n + ' trades)</span>' : '') + '</div>';
    var s = '<div>' + label + ' — ' + g.n + ' closed · win ' + g.win + '%' +
      (g.avgR !== null ? ' · avg ' + fmtR(g.avgR) : '') + ' · stops ' + g.stop + '%' +
      (g.pnl !== null ? ' · P&amp;L ' + (g.pnl >= 0 ? '+' : '-') + '$' + Math.abs(Math.round(g.pnl)) : '');
    if (bt) s += ' <span class="dim">vs backtest ' + bt.win + '% · ' + fmtR(bt.r) + ' · ' + bt.stop + '% stops</span>';
    return s + '</div>';
  }
  function scoreHTML(rows) {
    var closed = rows.filter(function (e) { return e.status !== "active"; });
    var open = rows.length - closed.length;
    var h = '<div class="hd">&#128202; Scoreboard — my live record vs the backtest</div>';
    if (closed.length === 0) {
      return h + '<div>No closed trades yet — when a trade closes, this board grades it against the 499-trade backtest. The number that matters most: the &#11088; ALL FOUR stop rate — 21% in the backtest. If live trades stop out much more often than that, the tag is not real.</div>' +
        '<div class="dim">Open trades: ' + open + ' · R = one plan risk (the 8% on a stock trade, the premium on an option trade)</div>';
    }
    var all = scoreGroup(closed);
    var g4 = scoreGroup(closed.filter(function (e) { return e.cls === "allfour"; }));
    var g2 = scoreGroup(closed.filter(function (e) { return e.cls === "two"; }));
    var go = scoreGroup(closed.filter(function (e) { return e.cls === "other"; }));
    var un = closed.filter(function (e) { return !e.cls; }).length;
    h += scoreLine('All trades', all, BT.all);
    h += scoreLine('&#11088; ALL FOUR', g4, BT.allfour);
    h += scoreLine('Magic + retest (2 of 4)', g2, BT.two);
    if (go.n) h += scoreLine('Not system trades', go, null);
    h += '<div class="dim">Open trades: ' + open + ' · R = one plan risk (8% stock / premium on options)' +
      (un ? ' · ' + un + ' closed trade' + (un === 1 ? '' : 's') + ' not class-tagged (in All trades only)' : '') +
      (closed.length < 30 ? ' · Early days — judge this board after 30+ closed trades' : '') + '</div>';
    return h;
  }

  function renderAll() {
    renderVetoes();
    var mine = unlocked() ? (serverRows || []) : loadLocal();
    lockBtn.textContent = unlocked() ? "Lock journal" : "I’m Aslam — unlock my journal";
    mineTitle.textContent = unlocked() ? "Aslam’s journal · unlocked" : "Your journal · this device";
    mineNote.textContent = unlocked()
      ? "You are writing to Aslam’s server journal — everyone can watch it, and it is the same on all your devices."
      : "Your journal is saved in this browser on this device only — nobody else can see it, and nothing is uploaded. Switching devices? Download a backup here, then restore it on the new device.";
    $("tj-stats").textContent = (unlocked() && serverRows === null) ? "" : statsText(mine);
    fillList($("tj-list"), $("tj-empty"), mine, true,
      unlocked() ? serverAction : localAction,
      unlocked() ? "No trades logged yet. Your first trade will live here." : "No trades logged yet. Your first trade will live here.");
    aslamSec.style.display = unlocked() ? "none" : "block";
    $("tj-score-mine").innerHTML = unlocked() ? (serverRows ? scoreHTML(serverRows) : "") : "";
    $("tj-score").innerHTML = unlocked() ? "" : ((serverRows && !serverError) ? scoreHTML(serverRows) : "");
    if (!unlocked()) {
      var aEmpty = $("tj-aslam-empty");
      if (serverError) {
        $("tj-aslam-stats").textContent = "";
        $("tj-aslam-list").innerHTML = "";
        aEmpty.style.display = "block";
        aEmpty.textContent = "Aslam’s journal could not load right now — try refreshing in a minute.";
      } else if (serverRows === null) {
        aEmpty.style.display = "block";
        aEmpty.textContent = "Loading Aslam’s journal…";
      } else {
        $("tj-aslam-stats").textContent = statsText(serverRows);
        fillList($("tj-aslam-list"), aEmpty, serverRows, false, null, "No trades yet — Aslam’s first logged trade will show here.");
      }
    }
  }

  /* ---------- unlock / lock ---------- */
  function askPin() {
    var p = prompt("Your journal PIN (only you can write in Aslam’s journal):");
    if (p) { localStorage.setItem(PIN_KEY, p); return true; }
    return false;
  }
  lockBtn.addEventListener("click", function () {
    if (unlocked()) {
      localStorage.removeItem(PIN_KEY);
      renderAll();
      return;
    }
    if (!askPin()) return;
    var local = loadLocal();
    renderAll();
    if (local.length > 0) {
      if (confirm("You have " + local.length + " trade(s) in this device’s journal. Upload them into Aslam’s online journal now?")) {
        var done = function () { saveLocal([]); fetchServer(); };
        if (serverRows !== null && serverRows.length === 0) {
          mutate({ action: "replace_all", entries: local }).then(done).catch(function (err) { alert(err.message); renderAll(); });
        } else {
          var chain = Promise.resolve();
          local.forEach(function (e) {
            chain = chain.then(function () { return mutate({ action: "add", entry: e }); });
          });
          chain.then(done).catch(function (err) { alert(err.message); renderAll(); });
        }
      }
    }
  });

  /* ---------- add trade ---------- */
  $("tj-add").addEventListener("click", function () {
    var t = tickerEl.value.trim().toUpperCase();
    var p = parseFloat(entryEl.value);
    if (!t) { tickerEl.focus(); return; }
    if (!p || p <= 0) { entryEl.focus(); return; }
    var entry = {
      id: Date.now(), ticker: t, entry: p,
      date: dateEl.value || todayLocal(),
      amount: parseFloat(amountEl.value) || null,
      status: "active", exitPrice: null, createdAt: Date.now()
    };
    if (clsEl.value) entry.cls = clsEl.value;
    if (jtype !== "stock") {
      var k1 = parseFloat(strikeEl.value), k2 = parseFloat(strike2El.value),
          prem = parseFloat(premiumEl.value), n = parseInt(contractsEl.value, 10);
      if (!k1 || k1 <= 0) { strikeEl.focus(); return; }
      if (jtype === "spread" && (!k2 || k2 <= k1)) { alert("For a call spread, the sell strike must be above the buy strike."); strike2El.focus(); return; }
      if (!expiryEl.value) { expiryEl.focus(); return; }
      if (!prem || prem <= 0) { premiumEl.focus(); return; }
      if (!n || n < 1) { contractsEl.focus(); return; }
      entry.jtype = jtype;
      entry.strike = k1;
      if (jtype === "spread") entry.strike2 = k2;
      entry.expiry = expiryEl.value;
      entry.premium = prem;
      entry.contracts = n;
      entry.amount = Math.round(prem * n * 100 * 100) / 100;
    }
    var after = function () {
      tickerEl.value = ""; entryEl.value = ""; amountEl.value = "";
      strikeEl.value = ""; strike2El.value = ""; premiumEl.value = "";
      contractsEl.value = ""; expiryEl.value = "";
      clsEl.value = "";
      dateEl.value = todayLocal();
      setType("stock");
      calc();
    };
    if (unlocked()) {
      mutate({ action: "add", entry: entry }).then(function () { after(); fetchServer(); })
        .catch(function (err) { alert(err.message); });
    } else {
      var rows = loadLocal();
      rows.push(entry);
      saveLocal(rows);
      after();
      renderAll();
    }
  });

  /* ---------- veto log actions ---------- */
  $("tj-veto-add").addEventListener("click", function () {
    var tEl = $("tj-v-ticker"), eEl = $("tj-v-entry"), dEl = $("tj-v-date"), rEl = $("tj-v-reason");
    var t = tEl.value.trim().toUpperCase();
    var p = parseFloat(eEl.value);
    if (!unlocked()) { alert("Unlock Aslam’s journal first — vetoes are written with the same PIN."); return; }
    if (!t) { tEl.focus(); return; }
    if (!p || p <= 0) { eEl.focus(); return; }
    var veto = {
      id: Date.now(), ticker: t, entry: p,
      date: dEl.value || todayLocal(),
      reason: rEl.value.trim(),
      createdAt: Date.now()
    };
    mutate({ action: "veto_add", veto: veto }).then(function () {
      tEl.value = ""; eEl.value = ""; rEl.value = "";
      dEl.value = todayLocal();
      fetchVetoes();
    }).catch(function (err) { alert(err.message); });
  });
  $("tj-veto-list").addEventListener("click", function (ev) {
    var btn = ev.target.closest("button[data-vdel]");
    if (!btn) return;
    var id = Number(btn.getAttribute("data-vdel"));
    var row = (vetoData && vetoData.vetoes || []).filter(function (v) { return v.id === id; })[0];
    if (!row) return;
    if (!confirm("Delete the " + row.ticker + " veto from the log?")) return;
    mutate({ action: "veto_delete", id: id }).then(fetchVetoes)
      .catch(function (err) { alert(err.message); });
  });

  /* ---------- backup / restore (acts on the journal you are looking at) ---------- */
  function currentRows() { return unlocked() ? (serverRows || []) : loadLocal(); }
  $("tj-export").addEventListener("click", function () {
    var blob = new Blob([JSON.stringify(currentRows(), null, 2)], { type: "application/json" });
    var a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = "trade-journal-backup.json";
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(function () { URL.revokeObjectURL(a.href); }, 2000);
  });
  var fileEl = $("tj-file");
  $("tj-import").addEventListener("click", function () { fileEl.click(); });
  fileEl.addEventListener("change", function () {
    var f = fileEl.files && fileEl.files[0];
    if (!f) return;
    var reader = new FileReader();
    reader.onload = function () {
      try {
        var data = JSON.parse(reader.result);
        if (!Array.isArray(data)) throw new Error("not a backup file");
        var clean = data.filter(function (r) {
          return r && typeof r.ticker === "string" && typeof r.entry === "number" && typeof r.date === "string";
        });
        if (clean.length === 0) { alert("That file has no trades in it."); return; }
        if (!confirm("Replace this journal with the backup (" + clean.length + " trades)?")) return;
        if (unlocked()) {
          mutate({ action: "replace_all", entries: clean }).then(function () {
            alert("Journal restored: " + clean.length + " trades.");
            fetchServer();
          }).catch(function (err) { alert(err.message); });
        } else {
          saveLocal(clean.map(function (r) {
            var out = {
              id: r.id || Date.now() + Math.random(), ticker: r.ticker, entry: r.entry,
              date: r.date, amount: typeof r.amount === "number" ? r.amount : null,
              status: ["active", "won", "lost", "time"].indexOf(r.status) >= 0 ? r.status : "active",
              exitPrice: typeof r.exitPrice === "number" ? r.exitPrice : null,
              createdAt: r.createdAt || Date.now()
            };
            if (r.jtype === "call" || r.jtype === "spread") {
              out.jtype = r.jtype;
              ["strike", "strike2", "premium"].forEach(function (k) {
                if (typeof r[k] === "number" && r[k] > 0) out[k] = r[k];
              });
              if (typeof r.expiry === "string" && r.expiry.length === 10) out.expiry = r.expiry;
              if (typeof r.contracts === "number" && r.contracts > 0) out.contracts = Math.floor(r.contracts);
              if (typeof r.exitPremium === "number" && r.exitPremium >= 0) out.exitPremium = r.exitPremium;
            }
            if (["allfour", "two", "other"].indexOf(r.cls) >= 0) out.cls = r.cls;
            return out;
          }));
          alert("Journal restored: " + clean.length + " trades.");
          renderAll();
        }
      } catch (err) {
        alert("That file could not be read as a journal backup.");
      }
      fileEl.value = "";
    };
    reader.readAsText(f);
  });

  [tickerEl, entryEl, dateEl, amountEl].forEach(function (el) {
    el.addEventListener("input", calc);
    el.addEventListener("change", calc);
  });
  [strikeEl, strike2El, expiryEl, premiumEl, contractsEl].forEach(function (el) {
    el.addEventListener("input", calc);
    el.addEventListener("change", calc);
  });
  $("tj-type-stock").addEventListener("click", function () { setType("stock"); });
  $("tj-type-call").addEventListener("click", function () { setType("call"); });
  $("tj-type-spread").addEventListener("click", function () { setType("spread"); });
  dateEl.value = todayLocal();
  $("tj-v-date").value = todayLocal();
  var edgeBtn = $("tj-edge-btn"), edgeBody = $("tj-edge-body");
  edgeBtn.addEventListener("click", function () {
    var open = edgeBody.style.display !== "none";
    edgeBody.style.display = open ? "none" : "block";
    edgeBtn.innerHTML = open
      ? "&#128200; Our trading edge &mdash; click here to read"
      : "&#128200; Our trading edge &mdash; click to hide";
  });
  calc();
  renderAll();
  fetchServer();
  fetchVetoes();
})();
</script>
{% endblock %}
